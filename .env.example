# LiteLLM on the Linux Docker host; replace with your gateway URL if remote.
# Multiple values are comma-separated and matched by position.
LITELLM_BASE_URLS=http://host.docker.internal:4000
LITELLM_API_KEYS=replace-with-your-key
LITELLM_GATEWAY_NAMES=主网关
WEBHOOK_URLS=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-your-key
# 15 minutes. Change this value to adjust the polling interval.
CHECK_INTERVAL_SECONDS=900
LITELLM_TIMEOUT_SECONDS=120
WEBHOOK_TIMEOUT_SECONDS=10
SQLITE_PATH=/app/data/health.sqlite3

