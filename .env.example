# LiteLLM on the Linux Docker host; replace with your gateway URL if remote.
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=replace-with-your-key
WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-your-key
# 15 minutes. Change this value to adjust the polling interval.
CHECK_INTERVAL_SECONDS=900
LITELLM_TIMEOUT_SECONDS=120
WEBHOOK_TIMEOUT_SECONDS=10
SQLITE_PATH=/app/data/health.sqlite3

