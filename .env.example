# LiteLLM Proxy 服务地址（不需要附带 /v1）
LITELLM_API_BASE=http://localhost:4000

# 推荐使用 proxy_admin_viewer 或具备只读统计权限的密钥
LITELLM_API_KEY=sk-your-litellm-key

# Dashboard 服务端口
PORT=3001

# 模型健康监控（间隔单位：分钟；模型列表支持 * 和 ? 通配符，按公开模型名匹配）
MODEL_HEALTH_INTERVAL_MINUTES=15
MODEL_HEALTH_INCLUDE_MODELS=
MODEL_HEALTH_EXCLUDE_MODELS=
MODEL_HEALTH_TIMEOUT_MS=30000
MODEL_HEALTH_CONCURRENCY=4
# 可选：初始企业微信机器人地址。也可在模型健康页面配置
WEWORK_WEBHOOK_URL=
